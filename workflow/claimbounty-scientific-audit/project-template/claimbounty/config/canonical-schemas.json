{
  "bundle_id": "claimbounty-canonical-schemas",
  "schema_version": "1.0.0",
  "json_schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "schemas": {
    "SourceLink": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/SourceLink/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "location"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "content_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "relationship": {"type": ["string", "null"]}
      }
    },
    "ProvenanceEntry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/ProvenanceEntry/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id", "timestamp", "input_ids", "output_ids"],
      "properties": {
        "kind": {"enum": ["script", "agent", "verifier", "runtime"]},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_version": {"type": ["string", "null"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "input_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "output_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rule_id": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "CanonicalObject": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/CanonicalObject/1.0.0",
      "type": "object",
      "required": ["id", "case_id", "case_version", "object_type", "schema_version", "status", "created_at", "created_by", "source_links", "provenance", "review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "case_version": {"type": "integer", "minimum": 1},
        "object_type": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0.0"},
        "status": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "version"],
          "properties": {
            "kind": {"enum": ["script", "agent", "verifier", "runtime"]},
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "source_links": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}},
        "provenance": {"type": "array", "items": {"$ref": "claimbounty://schemas/ProvenanceEntry/1.0.0"}},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reviewer_ids"],
          "properties": {
            "state": {"enum": ["unreviewed", "reviewed", "confirmed", "rejected", "incomplete", "disputed"]},
            "reviewer_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      }
    },
    "ClaimRecord": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/ClaimRecord/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["claim_text", "population", "exposure_or_treatment", "comparator", "outcome", "timepoint", "effect_measure", "direction", "scope", "reported_result_ids"],
          "properties": {
            "object_type": {"const": "ClaimRecord"},
            "claim_text": {"type": "string", "minLength": 1},
            "population": {"type": "string", "minLength": 1},
            "exposure_or_treatment": {"type": "string", "minLength": 1},
            "comparator": {"type": ["string", "null"]},
            "outcome": {"type": "string", "minLength": 1},
            "timepoint": {"type": ["string", "null"]},
            "effect_measure": {"type": "string", "minLength": 1},
            "direction": {"enum": ["increase", "decrease", "no_direction", "mixed", "unclear"]},
            "scope": {"type": "string", "minLength": 1},
            "reported_result_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Finding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/Finding/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["finding_type", "statement", "claim_id", "evidence_links", "method_review_ids", "independent_check_ids", "validity", "severity", "confidence", "allowed_wording"],
          "properties": {
            "object_type": {"const": "Finding"},
            "finding_type": {"enum": ["reproduction", "robustness", "literature", "claim_language", "data", "code"]},
            "statement": {"type": "string", "minLength": 1},
            "claim_id": {"type": "string", "minLength": 1},
            "estimand_id": {"type": ["string", "null"]},
            "evidence_links": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}, "minItems": 1},
            "method_review_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "independent_check_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "validity": {"enum": ["verified", "verified_with_limits", "rejected", "incomplete", "disputed"]},
            "severity": {"enum": ["informational", "minor", "moderate", "major", "blocking"]},
            "confidence": {"enum": ["low", "medium", "high"]},
            "allowed_wording": {"type": ["string", "null"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ClaimStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/ClaimStatus/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["claim_id", "reproduction", "robustness", "evidence_alignment", "summary"],
          "properties": {
            "object_type": {"const": "ClaimStatus"},
            "claim_id": {"type": "string", "minLength": 1},
            "reproduction": {"enum": ["exact", "within_tolerance", "patched_reproduction", "partial", "mismatch", "not_executable", "not_assessable"]},
            "robustness": {"enum": ["stable", "stable_with_limits", "fragile", "mixed", "not_assessable"]},
            "evidence_alignment": {"enum": ["support", "contradiction", "warning", "context", "mixed", "not_comparable", "not_assessable"]},
            "summary": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Recommendation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/Recommendation/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["title", "action", "priority", "effort", "owner", "expected_effect", "verification_method", "evidence_links"],
          "properties": {
            "object_type": {"const": "Recommendation"},
            "title": {"type": "string", "minLength": 1},
            "action": {"type": "string", "minLength": 1},
            "priority": {"enum": ["low", "medium", "high", "blocking"]},
            "effort": {"enum": ["small", "medium", "large", "unknown"]},
            "owner": {"type": "string", "minLength": 1},
            "expected_effect": {"type": "string", "minLength": 1},
            "verification_method": {"type": "string", "minLength": 1},
            "evidence_links": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}, "minItems": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Limitation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/Limitation/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["area", "description", "consequence", "blocking", "untested", "evidence_links"],
          "properties": {
            "object_type": {"const": "Limitation"},
            "area": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "consequence": {"type": "string", "minLength": 1},
            "blocking": {"type": "boolean"},
            "untested": {"type": "boolean"},
            "evidence_links": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ReleaseGate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/ReleaseGate/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "details", "evidence_links"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "limited", "blocking"]},
        "details": {"type": "string"},
        "evidence_links": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}}
      }
    },
    "FileArtifact": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/FileArtifact/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["role", "path", "media_type", "size_bytes", "sha256", "access", "derived_from_ids"],
          "properties": {
            "object_type": {"const": "FileArtifact"},
            "role": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "media_type": {"type": "string", "minLength": 1},
            "size_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
            "access": {"enum": ["internal", "restricted", "public"]},
            "derived_from_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "SourceRecord": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/SourceRecord/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["title", "source_type", "identifiers", "access_status", "licence", "retrieved_at", "screening_status", "passage_ids"],
          "properties": {
            "object_type": {"const": "SourceRecord"},
            "title": {"type": "string", "minLength": 1},
            "source_type": {"enum": ["journal_article", "preprint", "review", "methods_guidance", "dataset", "user_supplied", "other"]},
            "identifiers": {"type": "object", "additionalProperties": {"type": "string"}},
            "access_status": {"enum": ["open_access", "user_authorized", "abstract_only", "inaccessible"]},
            "licence": {"type": ["string", "null"]},
            "retrieved_at": {"type": "string", "format": "date-time"},
            "screening_status": {"enum": ["included", "excluded", "duplicate", "inaccessible", "pending"]},
            "exclusion_reason": {"type": ["string", "null"]},
            "passage_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ReplayRecord": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/ReplayRecord/1.0.0",
      "allOf": [
        {"$ref": "claimbounty://schemas/CanonicalObject/1.0.0"},
        {
          "type": "object",
          "required": ["replay_status", "package_path", "entrypoint", "environment_ids", "input_artifact_ids", "output_artifact_ids", "limitation_ids"],
          "properties": {
            "object_type": {"const": "ReplayRecord"},
            "replay_status": {"enum": ["verified", "verified_with_limits", "unavailable"]},
            "package_path": {"type": ["string", "null"]},
            "entrypoint": {"type": ["string", "null"]},
            "environment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "input_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "output_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "limitation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "FrozenAuditInputs": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/FrozenAuditInputs/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "audit_version", "workflow_run_id", "case_id", "frozen_at", "verified_object_ids", "artifact_hashes", "schema_hashes", "template_hash", "excluded_unverified_object_ids"],
      "properties": {
        "audit_id": {"type": "string", "minLength": 1},
        "audit_version": {"type": "integer", "minimum": 1},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "format": "date-time"},
        "verified_object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "artifact_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "sha256"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
            }
          }
        },
        "schema_hashes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_id", "schema_version", "sha256"],
            "properties": {
              "schema_id": {"type": "string", "minLength": 1},
              "schema_version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
            }
          }
        },
        "template_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "excluded_unverified_object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "OpenDecision": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/OpenDecision/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "question", "options", "evidence", "owner", "blocking", "deadline", "status", "decision", "reason"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {}},
        "evidence": {"type": "array", "items": {"$ref": "claimbounty://schemas/SourceLink/1.0.0"}},
        "owner": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["open", "decided", "deferred"]},
        "decision": {},
        "reason": {"type": ["string", "null"]}
      }
    },
    "AuditPackageManifest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "claimbounty://schemas/AuditPackageManifest/1.0.0",
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "audit_version", "workflow_run_id", "terminal_status", "files", "release_gates", "limitations"],
      "properties": {
        "audit_id": {"type": "string", "minLength": 1},
        "audit_version": {"type": "integer", "minimum": 1},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "terminal_status": {"enum": ["audit_completed", "audit_completed_with_limits", "operationally_blocked"]},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "media_type", "sha256", "access"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "media_type": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "access": {"enum": ["internal", "restricted", "public"]}
            }
          }
        },
        "release_gates": {"type": "array", "items": {"$ref": "claimbounty://schemas/ReleaseGate/1.0.0"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
