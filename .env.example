APP_ENV=development
COMPOSE_PROJECT_NAME=micro1-template
POSTGRES_PORT=5432
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_READINESS_TIMEOUT=2s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576
LOG_LEVEL=info
LOG_FORMAT=text
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_QUERY_TIMEOUT=5s
DATABASE_MIGRATION_TIMEOUT=1m
DATABASE_AUTO_MIGRATE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_APP_NAME="Micro1 Template"
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT_MS=10000
