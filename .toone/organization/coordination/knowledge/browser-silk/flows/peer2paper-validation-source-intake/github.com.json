      "type": "string",
      "required": true,
      "description": "GitHub repository name"
    }
  },
  "funnels": [
    {
      "id": "inspect_public_repository",
      "name": "Inspect public repository",
      "description": "Open a public GitHub repository and extract its file list, README, licence, and source links before a reproducible clone.",
      "repeatable": true,
      "steps": [
        {
          "id": "open_repository",
          "action": "navigate",
