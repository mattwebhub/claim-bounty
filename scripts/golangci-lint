#!/bin/sh
set -eu

version='2.13.1'
repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${GOLANGCI_LINT_BIN:-}" ]; then
  exec "$GOLANGCI_LINT_BIN" "$@"
fi

operating_system=$(uname -s | tr '[:upper:]' '[:lower:]')
machine_architecture=$(uname -m)
case "$machine_architecture" in
  x86_64) machine_architecture='amd64' ;;
  aarch64 | arm64) machine_architecture='arm64' ;;
  *)
    printf 'golangci-lint: unsupported architecture: %s\n' "$machine_architecture" >&2
    exit 1
    ;;
esac

case "$operating_system-$machine_architecture" in
  darwin-amd64) expected_checksum='2c373363953e4e0bee2a03b7fe864a5eb6a3822927cb077d9ca33f2ae3cb2da2' ;;
  darwin-arm64) expected_checksum='0c9818baf6fb8ad26c6d2ef51b68d5a1e260ef07727036b1431647cc44637c7c' ;;
  linux-amd64) expected_checksum='b17bfbc9d4aaa48be7f4f1ce3240bc3d8200c870c072bacf15c26219e2cfb9cc' ;;
  linux-arm64) expected_checksum='908317c23db18448f924e853b3d8a659fd919614cd438f224810a4053daa2607' ;;
  *)
    printf 'golangci-lint: unsupported platform: %s-%s\n' "$operating_system" "$machine_architecture" >&2
    exit 1
    ;;
esac

tool_directory="${MICRO1_TOOLS_CACHE:-$repository_root/.cache/tools}/golangci-lint/$version/$operating_system-$machine_architecture"
binary_path="$tool_directory/golangci-lint"
if [ ! -x "$binary_path" ]; then
  command -v curl >/dev/null 2>&1 || {
    printf 'golangci-lint: curl is required for the first pinned binary install\n' >&2
    exit 1
  }
  command -v tar >/dev/null 2>&1 || {
    printf 'golangci-lint: tar is required for the first pinned binary install\n' >&2
    exit 1
  }

  archive_name="golangci-lint-$version-$operating_system-$machine_architecture.tar.gz"
  download_directory=$(mktemp -d "${TMPDIR:-/tmp}/micro1-golangci-lint.XXXXXX")
  trap 'rm -rf "$download_directory"' EXIT INT TERM
  archive_path="$download_directory/$archive_name"
  download_url="https://github.com/golangci/golangci-lint/releases/download/v$version/$archive_name"

  printf 'golangci-lint: installing pinned binary v%s for %s-%s\n' "$version" "$operating_system" "$machine_architecture"
  curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --output "$archive_path" "$download_url"
  if command -v sha256sum >/dev/null 2>&1; then
    actual_checksum=$(sha256sum "$archive_path" | awk '{print $1}')
  else
    actual_checksum=$(shasum -a 256 "$archive_path" | awk '{print $1}')
  fi
  if [ "$actual_checksum" != "$expected_checksum" ]; then
    printf 'golangci-lint: checksum mismatch for %s\n' "$archive_name" >&2
    exit 1
  fi

  mkdir -p "$tool_directory"
  tar -xzf "$archive_path" -C "$download_directory"
  install -m 0755 "$download_directory/golangci-lint-$version-$operating_system-$machine_architecture/golangci-lint" "$binary_path"
fi

exec "$binary_path" "$@"
