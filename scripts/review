#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
mode=${1:---local}
zero='0000000000000000000000000000000000000000'

resolve_push_base() {
  if push_ref=$(git rev-parse --verify --symbolic-full-name '@{push}' 2>/dev/null); then
    printf '%s\n' "$push_ref"
  elif upstream_ref=$(git rev-parse --verify --symbolic-full-name '@{upstream}' 2>/dev/null); then
    printf '%s\n' "$upstream_ref"
  elif git rev-parse --verify origin/main^{commit} >/dev/null 2>&1; then
    printf '%s\n' origin/main
  elif git rev-parse --verify main^{commit} >/dev/null 2>&1; then
    printf '%s\n' main
  else
    printf 'review: cannot determine a push base\n' >&2
    exit 2
  fi
}

review_push_refs() {
  refs_file=$1
  reviewed=0

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    [ "$local_sha" != "$zero" ] || continue
    reviewed=1

    if [ "$remote_sha" = "$zero" ]; then
      fallback=$(resolve_push_base)
      fallback_sha=$(git rev-parse --verify "$fallback^{commit}")
      base_sha=$(git merge-base "$fallback_sha" "$local_sha")
      printf 'review: new ref %s; comparing against %s\n' "$remote_ref" "$fallback"
    else
      base_sha=$remote_sha
      printf 'review: comparing %s against remote %s\n' "$local_ref" "$remote_ref"
    fi

    "$root/scripts/ai-review" --range "$base_sha" "$local_sha" || return $?
  done <"$refs_file"

  if [ "$reviewed" -eq 0 ]; then
    printf 'review: push contains deletions only; no semantic diff to review\n'
  fi
}

validate_push_refs() {
  refs_file=$1
  current_head=$(git rev-parse HEAD)

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    [ "$local_sha" != "$zero" ] || continue

    pushed_commit=$(git rev-parse --verify "$local_sha^{commit}") || {
      printf 'review: %s does not resolve to a commit\n' "$local_ref" >&2
      exit 2
    }
    if [ "$pushed_commit" != "$current_head" ]; then
      printf 'review: %s is not the checked-out commit; check out and push each distinct commit separately\n' "$local_ref" >&2
      exit 2
    fi
  done <"$refs_file"
}

case "$mode" in
  --local)
    [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || {
      printf 'usage: scripts/review [--local | --push | --uncommitted]\n' >&2
      exit 2
    }
    if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
      review_mode='uncommitted'
    else
      review_mode='push'
    fi
    ;;
  --push)
    [ "$#" -eq 1 ] || exit 2
    review_mode='push'
    ;;
  --uncommitted)
    [ "$#" -eq 1 ] || exit 2
    review_mode='uncommitted'
    ;;
  *)
    printf 'usage: scripts/review [--local | --push | --uncommitted]\n' >&2
    exit 2
    ;;
esac

refs_file=''
if [ "$review_mode" = 'push' ] && [ ! -t 0 ]; then
  refs_file=$(mktemp "${TMPDIR:-/tmp}/micro1-push-refs.XXXXXX")
  trap 'rm -f "$refs_file"' EXIT INT TERM
  sed -n 'p' >"$refs_file"
fi

if [ "$review_mode" = 'push' ]; then
  if [ -n "$(git status --porcelain)" ]; then
    printf 'review: pre-push requires a clean worktree so tests run against the exact pushed tree\n' >&2
    exit 2
  fi
  if [ -n "$refs_file" ] && [ -s "$refs_file" ]; then
    validate_push_refs "$refs_file"
  fi
fi

printf 'review: running complete deterministic gate\n'
make -C "$root" check-ci

if [ "$review_mode" = 'uncommitted' ]; then
  exec "$root/scripts/ai-review" --uncommitted
fi

if [ -n "$refs_file" ] && [ -s "$refs_file" ]; then
  review_push_refs "$refs_file"
  exit 0
fi

base=$(resolve_push_base)
printf 'review: no Git ref tuples supplied; comparing HEAD against %s\n' "$base"
exec "$root/scripts/ai-review" --base "$base"
