#!/bin/sh
set -eu

failures=0

require() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'ok   %-16s %s\n' "$1" "$(command -v "$1")"
  else
    printf 'FAIL %-16s missing; %s\n' "$1" "$2"
    failures=$((failures + 1))
  fi
}

require go 'install Go 1.26.6 or newer'
require git 'install Git'
require docker 'install Docker with Compose v2'
require curl 'install curl for local smoke checks'

if command -v go >/dev/null 2>&1; then
  go_version=$(go env GOVERSION)
  version_numbers=${go_version#go}
  major=${version_numbers%%.*}
  remainder=${version_numbers#*.}
  minor=${remainder%%.*}
  patch=${remainder#*.}
  patch=${patch%%[^0-9]*}
  if [ "$major" -gt 1 ] || { [ "$major" -eq 1 ] && { [ "$minor" -gt 26 ] || { [ "$minor" -eq 26 ] && [ "${patch:-0}" -ge 6 ]; }; }; }; then
    printf 'ok   %-16s %s\n' 'Go version' "$go_version"
  else
    printf 'FAIL %-16s %s; Go 1.26.6+ required\n' 'Go version' "$go_version"
    failures=$((failures + 1))
  fi
fi

if command -v docker >/dev/null 2>&1; then
  if docker compose version >/dev/null 2>&1; then
    printf 'ok   %-16s available\n' 'Docker Compose'
  else
    printf 'FAIL %-16s unavailable; install the Compose v2 plugin\n' 'Docker Compose'
    failures=$((failures + 1))
  fi
fi

if [ -n "${DATABASE_URL:-}" ]; then
  printf 'ok   %-16s supplied\n' 'DATABASE_URL'
else
  printf 'info %-16s using documented local default\n' 'DATABASE_URL'
fi

if [ "$failures" -ne 0 ]; then
  printf '\ndoctor: %s required check(s) failed\n' "$failures"
  exit 1
fi
printf '\ndoctor: environment is ready\n'
