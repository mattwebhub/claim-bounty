#!/bin/sh
set -eu

target=${1:-.}
case "$target" in
  /*) ;;
  *) target="$(pwd)/$target" ;;
esac

if [ ! -e "$target" ]; then
  printf 'context: path does not exist: %s\n' "$target" >&2
  exit 2
fi

printf 'Repository: %s\n' "$(pwd)"
printf 'Target:     %s\n\n' "$target"
printf 'Read first:\n  AGENTS.md\n  ARCHITECTURE.md\n  architecture/rules.yaml\n\n'
printf 'Dependency direction:\n  domain -> standard library\n  ports -> domain\n  services -> domain, ports\n  adapters -> domain, ports\n  transport -> domain, service-facing interfaces\n  bootstrap -> concrete wiring only\n\n'
printf 'Nearest tests:\n'
target_dir=$target
[ -f "$target" ] && target_dir=$(dirname "$target")
find "$target_dir" -maxdepth 2 -name '*_test.go' -type f 2>/dev/null | sort | sed 's#^#  #' || true
printf '\nSmallest verification:\n  go test ./...\n  make arch\n\n'
printf 'Full handoff gate:\n  make check\n'
