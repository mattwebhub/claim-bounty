# Copy to .env only if your process runner loads dotenv files. The API itself
# reads the process environment and never mutates it.
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_READINESS_TIMEOUT=2s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_QUERY_TIMEOUT=5s
DATABASE_MIGRATION_TIMEOUT=1m
DATABASE_AUTO_MIGRATE=true
