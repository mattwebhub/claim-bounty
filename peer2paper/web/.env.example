# Public Supabase project values. The anon key is safe for browsers when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL, without a trailing slash. Override with
# http://localhost:3000 in .env.local for local authentication callbacks.
NEXT_PUBLIC_SITE_URL=https://peer2paper.com
NEXT_PUBLIC_LEGAL_EMAIL=privacy@peer2paper.com
