{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer2paper.com/schemas/stage-observations.schema.json",
  "title": "Peer2Paper sealed stage validation observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "run_id",
    "producer_stage",
    "observations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "producer_stage": {
      "enum": [
        "study_case",
        "reproduction",
        "robustness",
        "research",
        "verification",
        "delivery"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "value", "evidence"],
      "properties": {
        "target_id": { "$ref": "#/$defs/identifier" },
        "value": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_uri", "artifact_sha256", "json_pointer"],
      "properties": {
        "artifact_uri": { "type": "string", "minLength": 1 },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "json_pointer": { "type": "string", "pattern": "^$|^/" }
      }
    }
  }
}
