{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer2paper.com/schemas/grading-submission.schema.json",
  "title": "Peer2Paper final grading submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "case_id",
    "run_id",
    "phase",
    "answers"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "submission_id": { "$ref": "#/$defs/identifier" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "phase": { "const": "final" },
    "answers": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "value", "evidence"],
        "properties": {
          "target_id": { "$ref": "#/$defs/identifier" },
          "value": {},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_uri", "artifact_sha256"],
              "properties": {
                "artifact_uri": { "type": "string", "minLength": 1 },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "json_pointer": {
                  "type": "string",
                  "pattern": "^$|^/"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
