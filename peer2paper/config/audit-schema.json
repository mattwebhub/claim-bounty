{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer2paper.com/schemas/ScientificAudit/1.0.0",
  "title": "Peer2Paper Scientific Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "audit_version",
    "schema_version",
    "workflow_run_id",
    "case_id",
    "generated_at",
    "purpose",
    "terminal_status",
    "claim_statuses",
    "findings",
    "recommendations",
    "limitations",
    "evidence_links",
    "provenance",
    "replay",
    "release_gates",
    "manifest"
  ],
  "properties": {
    "audit_id": {"type": "string", "minLength": 1},
    "audit_version": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "1.0.0"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["audit_completed", "audit_completed_with_limits", "operationally_blocked"]},
    "executive_summary": {"type": "string"},
    "audit_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_claim_ids", "included_artifact_ids", "external_search_authorized", "release_scope"],
      "properties": {
        "target_claim_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "included_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "external_search_authorized": {"type": "boolean"},
        "release_scope": {"enum": ["internal", "restricted", "public"]}
      }
    },
    "claim_statuses": {"type": "array", "items": {"$ref": "#/$defs/claimStatus"}, "minItems": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}},
    "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenanceEntry"}, "minItems": 1},
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "package_path", "entrypoint", "environment_ids", "input_hashes", "output_hashes"],
      "properties": {
        "status": {"enum": ["verified", "verified_with_limits", "unavailable"]},
        "package_path": {"type": ["string", "null"]},
        "entrypoint": {"type": ["string", "null"]},
        "environment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input_hashes": {"type": "array", "items": {"$ref": "#/$defs/hashRecord"}},
        "output_hashes": {"type": "array", "items": {"$ref": "#/$defs/hashRecord"}},
        "limitation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "release_gates": {"type": "array", "items": {"$ref": "#/$defs/releaseGate"}, "minItems": 1},
    "manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "sha256", "access"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "access": {"enum": ["internal", "restricted", "public"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_status": {"const": "audit_completed"}}},
      "then": {
        "properties": {
          "release_gates": {
            "not": {"contains": {"properties": {"status": {"enum": ["limited", "blocking"]}}, "required": ["status"]}}
          }
        }
      }
    },
    {
      "if": {"properties": {"terminal_status": {"const": "audit_completed_with_limits"}}},
      "then": {
        "properties": {
          "release_gates": {
            "contains": {"properties": {"status": {"const": "limited"}}, "required": ["status"]},
            "not": {"contains": {"properties": {"status": {"const": "blocking"}}, "required": ["status"]}}
          },
          "limitations": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"terminal_status": {"const": "operationally_blocked"}}},
      "then": {
        "properties": {
          "release_gates": {"contains": {"properties": {"status": {"const": "blocking"}}, "required": ["status"]}},
          "limitations": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "location"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "content_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "relationship": {"type": ["string", "null"]}
      }
    },
    "hashRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id", "timestamp", "input_ids", "output_ids"],
      "properties": {
        "kind": {"enum": ["script", "agent", "verifier", "runtime"]},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_version": {"type": ["string", "null"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "input_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "output_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rule_id": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "claimStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "reproduction", "robustness", "evidence_alignment", "summary", "evidence_links"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "reproduction": {"enum": ["exact", "within_tolerance", "patched_reproduction", "partial", "mismatch", "not_executable", "not_assessable"]},
        "robustness": {"enum": ["stable", "stable_with_limits", "fragile", "mixed", "not_assessable"]},
        "evidence_alignment": {"enum": ["support", "contradiction", "warning", "context", "mixed", "not_comparable", "not_assessable"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "type", "statement", "claim_id", "evidence_links", "method_review_ids", "independent_check_ids", "validity", "severity", "confidence", "allowed_wording"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["reproduction", "robustness", "literature", "claim_language", "data", "code"]},
        "statement": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "estimand_id": {"type": ["string", "null"]},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}, "minItems": 1},
        "method_review_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "independent_check_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "validity": {"enum": ["verified", "verified_with_limits", "rejected", "incomplete", "disputed"]},
        "severity": {"enum": ["informational", "minor", "moderate", "major", "blocking"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "allowed_wording": {"type": ["string", "null"]}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "action", "priority", "effort", "owner", "expected_effect", "verification_method", "evidence_links"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "priority": {"enum": ["low", "medium", "high", "blocking"]},
        "effort": {"enum": ["small", "medium", "large", "unknown"]},
        "owner": {"type": "string", "minLength": 1},
        "expected_effect": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}, "minItems": 1}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "description", "consequence", "blocking", "untested", "evidence_links"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "untested": {"type": "boolean"},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}}
      }
    },
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "details", "evidence_links"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "limited", "blocking"]},
        "details": {"type": "string"},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/sourceLink"}}
      }
    }
  }
}
