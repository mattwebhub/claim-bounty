{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peer2paper.com/schemas/execution-manifest-1.0.0.json",
  "title": "Peer2Paper execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "runId",
    "attemptId",
    "attemptDirectory",
    "workingDirectory",
    "command",
    "runtime",
    "network"
  ],
  "properties": {
    "protocolVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "attemptDirectory": { "type": "string", "minLength": 1 },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requiredPackages"],
      "properties": {
        "kind": { "enum": ["R", "Python"] },
        "executable": { "type": "string" },
        "minimumVersion": { "type": "string" },
        "libraryPath": { "type": "string" },
        "requiredPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "network": { "enum": ["disabled", "host-policy"] },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 600 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximumMemoryBytes": { "type": "integer", "minimum": 1, "default": 8589934592 },
        "maximumWorkingStorageBytes": { "type": "integer", "minimum": 1, "default": 5368709120 }
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["read-only", "read-write"] },
          "verifyUnchanged": { "type": "boolean", "default": false }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
